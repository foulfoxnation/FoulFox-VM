#!/bin/sh
# FoulFox OS kiosk X session (launched by LightDM autologin as user foulfox).
# Starts the window manager, the Windows-VM viewer watcher, and a fullscreen
# Chromium pointed at the locally-served FoulFox VM shell.
#
# Both openbox and chromium are wrapped in restart loops so a crash (e.g. a
# GPU fault, OOM kill, or a misbehaving overlay browser window taking out X)
# returns to the kiosk instead of leaving the user with a black screen.

# shellcheck disable=SC1091
[ -f /etc/foulfox/foulfox.env ] && . /etc/foulfox/foulfox.env
export HOME=/var/lib/foulfox

# Always-on appliance: no screen blanking or power management.
xset s off -dpms s noblank 2>/dev/null || true

# Attach the fullscreen Windows-VM viewer whenever the guest is up (background).
/usr/local/bin/foulfox-open-vm-viewer &

# Window manager — restart automatically if it crashes so windows stay manageable.
( while true; do
    openbox 2>/dev/null || true
    sleep 2
  done ) &

# Taskbar — one button per open window + clock at the bottom of the screen,
# so background windows always have a visible dock. Restarted if it crashes.
# Config: /etc/xdg/tint2/tint2rc (foulfox has no per-user override).
( while true; do
    tint2 2>/dev/null || true
    sleep 2
  done ) &

# Wait for the api-server to serve the shell before opening the browser.
# No time limit: launching Chromium at the shell URL before the API is up
# strands the user on a "127.0.0.1 refused to connect" error page that never
# retries (a slow or offline first boot can easily exceed a fixed budget).
# After a grace period, show a local "still starting" splash so a fail-closed
# prepare failure is visible instead of an indefinite black screen; the splash
# is replaced by the real shell the moment the API answers.
url="http://127.0.0.1:${PORT:-8080}/"
splash_pid=""
waited=0
while ! curl -sf -o /dev/null "$url"; do
  waited=$((waited + 1))
  if [ "$waited" -eq 45 ] && [ -z "$splash_pid" ]; then
    chromium \
      --class=FoulFoxSplash \
      --disable-gpu-compositing \
      --kiosk --no-first-run --disable-infobars --noerrdialogs \
      --disable-session-crashed-bubble --password-store=basic \
      "data:text/html,<html><body style='background:%23111;color:%23ddd;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0'><div style='max-width:40em;text-align:center'><h1 style='color:%23f80'>FoulFox OS is still starting&%238230;</h1><p>Services are taking longer than usual. This screen will be replaced automatically once they are up.</p><p style='color:%23888;font-size:0.9em'>If it never does: press Ctrl+Alt+F2, log in, and run<br><code>journalctl -u foulfox-prepare -u foulfox-api -b</code></p></div></body></html>" \
      2>/dev/null &
    splash_pid=$!
  fi
  sleep 1
done
[ -n "$splash_pid" ] && kill "$splash_pid" 2>/dev/null

# ── PulseAudio (required for Voice Forge mic + speaker access) ───────────────
# Start PulseAudio as a user-mode daemon for the foulfox kiosk session.
# Chromium uses PulseAudio for getUserMedia (microphone) and audio output
# (speaker). Without it, all MediaDevices calls return empty device lists and
# TTS playback is silent.
# --exit-idle-time=-1: never auto-exit on idle — this is an always-on appliance.
# --log-target=syslog: keeps the kiosk console clean; use journalctl to debug.
# The `|| true` prevents the kiosk from aborting if pulseaudio is already up.
pulseaudio --start --exit-idle-time=-1 --log-target=syslog 2>/dev/null || true

# Give PulseAudio a moment to detect ALSA sound cards before Chromium opens.
sleep 1

# Hands-free voice apps: no gesture requirement for audio playback. The mic
# grant itself comes from the managed policy in
# /etc/chromium/policies/managed/foulfox-media.json (AudioCaptureAllowedUrls),
# which auto-allows getUserMedia for the local shell origin without a prompt.
#
# Chromium is NOT exec'd so that this script (the LightDM session process)
# stays alive as the watchdog. If chromium crashes or is killed (e.g. a rogue
# Firefox window closes the whole X display), it restarts automatically.
# --app (not --kiosk): an app window is borderless but NOT fullscreen, so the
# tint2 taskbar at the bottom stays visible. The openbox rule for the
# FoulFoxKiosk class keeps it undecorated + maximized (respecting the panel's
# reserved strip); --kiosk would map true-fullscreen and cover the taskbar.
while true; do
  chromium \
    --class=FoulFoxKiosk \
    --disable-gpu-compositing \
    --app="$url" \
    --start-maximized \
    --no-first-run \
    --disable-infobars \
    --disable-translate \
    --noerrdialogs \
    --disable-session-crashed-bubble \
    --check-for-update-interval=31536000 \
    --password-store=basic \
    --autoplay-policy=no-user-gesture-required \
    --remote-debugging-port=9222 \
    --remote-debugging-address=127.0.0.1 \
    2>/dev/null || true
  sleep 3
done
