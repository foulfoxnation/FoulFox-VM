#!/usr/bin/env bash
# FoulFox OS first-run provisioning. Idempotent: safe to run on every boot.
#
# Creates the runtime dirs, fixes ownership, locates a user-supplied Windows ISO
# and the virtio-win driver ISO (frontloaded via the File Explorer or present on
# removable media), creates the guest disk, and writes the VM config that the
# api-server reads. The api-server merges this file with its defaults on load,
# so only the appliance-relevant fields are written here.
set -euo pipefail

# shellcheck disable=SC1091
[ -f /etc/foulfox/foulfox.env ] && . /etc/foulfox/foulfox.env

# Keep this aligned with foulfox-patcher's FF_HOME (ODYSSEUS_DATA_DIR wins) so both
# create/own/prune the SAME updater root even when the data dir is a separate mount.
FOULFOX_HOME="${ODYSSEUS_DATA_DIR:-${HOME:-/var/lib/foulfox}}"
STAGING="${FRONTLOAD_STAGING_DIR:-$FOULFOX_HOME/frontload}"
VM_DIR="$FOULFOX_HOME/vm"
CONFIG="$FOULFOX_HOME/.odysseus-vm-config.json"
DISK="$VM_DIR/windows.qcow2"
DISK_SIZE="${VM_DISK_SIZE:-64G}"
RAM_GB="${VM_RAM_GB:-8}"
CPU_CORES="${VM_CPU_CORES:-4}"
DISPLAY_MODE="${VM_DISPLAY_MODE:-spice}"
SPICE_PORT="${VM_SPICE_PORT:-5930}"

mkdir -p "$STAGING/drivers" "$STAGING/isos" "$STAGING/files" "$VM_DIR" "$FOULFOX_HOME/logs"

# ── User home folders ─────────────────────────────────────────────────────────
# Documents (with Screenshots sub-folder used by the PrintScreen keybinding)
# and Downloads. Created here so they exist on first boot regardless of whether
# the persistence partition is present; the chown below covers them.
FOULFOX_USER_HOME=$(getent passwd foulfox 2>/dev/null | cut -d: -f6 || echo "/var/lib/foulfox")
mkdir -p \
  "$FOULFOX_USER_HOME/Documents/Screenshots" \
  "$FOULFOX_USER_HOME/Downloads"
chown foulfox:foulfox \
  "$FOULFOX_USER_HOME/Documents" \
  "$FOULFOX_USER_HOME/Documents/Screenshots" \
  "$FOULFOX_USER_HOME/Downloads" 2>/dev/null || true

# ── Local AI model seeding: MOVED to foulfox-seed-ollama.service ─────────────
# The ~5 GB baked-model copy used to run here and blocked the entire boot chain
# (api-server + Odysseus Require this unit) for minutes on slow USB storage.
# It now runs deferred, AFTER the shell and Odysseus are up. Only the dirs are
# created here so ollama.service can start (with no models yet) immediately.
mkdir -p "$FOULFOX_HOME/ollama/models"
chown -R foulfox:foulfox "$FOULFOX_HOME/ollama" 2>/dev/null || true

# ── Embedding model seeding (baked fastembed cache → persistent partition) ───
# The image bakes the Odysseus semantic-memory embedding model read-only at
# /opt/foulfox/fastembed-cache (0050 hook). Odysseus reads/writes
# $FOULFOX_HOME/fastembed_cache (its FASTEMBED_CACHE_DIR default under
# ODYSSEUS_DATA_DIR). Seed it once so the agent NEVER needs the internet to
# come online at boot; marker only on success so a half-copy retries.
BAKED_FASTEMBED=/opt/foulfox/fastembed-cache
FASTEMBED_DEST="$FOULFOX_HOME/fastembed_cache"
FASTEMBED_SEED_MARKER="$FOULFOX_HOME/.baked-fastembed-seeded"
if [ -d "$BAKED_FASTEMBED" ] && [ ! -f "$FASTEMBED_SEED_MARKER" ]; then
  echo "[foulfox-first-run] Seeding baked embedding model into $FASTEMBED_DEST ..."
  mkdir -p "$FASTEMBED_DEST"
  if rsync -a "$BAKED_FASTEMBED/" "$FASTEMBED_DEST/"; then
    touch "$FASTEMBED_SEED_MARKER"
    echo "[foulfox-first-run] Embedding model seeded."
  else
    echo "[foulfox-first-run] WARNING: embedding model seed copy failed; will retry next boot." >&2
  fi
  chown -R foulfox:foulfox "$FASTEMBED_DEST" 2>/dev/null || true
fi

# Updater state the patcher mutates AS ROOT (downloaded bundles, extracted
# releases, shared venvs, and the status/rollback/boot-recovery markers) stays
# root-owned so the unprivileged 'foulfox' service user — which runs the
# network-facing api-server and can invoke the patcher via sudo — cannot tamper
# with a verified release or forge the boot-recovery marker. Create them root-owned
# now and EXCLUDE them from the recursive chown below.
UPDATE_DIRS="$FOULFOX_HOME/releases $FOULFOX_HOME/venvs $FOULFOX_HOME/update-staging $FOULFOX_HOME/updates"
# shellcheck disable=SC2086  # deliberate word-splitting of the dir list
mkdir -p $UPDATE_DIRS
# shellcheck disable=SC2086
chown root:root $UPDATE_DIRS 2>/dev/null || true
# shellcheck disable=SC2086
chmod 755 $UPDATE_DIRS 2>/dev/null || true

# ── App release indirection (live-update support) ────────────────────────────
# The systemd services run from $FOULFOX_HOME/app-current (a symlink) rather than
# the baked /opt/foulfox/app, so foulfox-patcher can atomically swap in a new app
# release and roll back. The baked app is "release 0": (re)create the pointer when
# it is missing or dangling (e.g. a release was pruned or persistence was lost) so
# the device always boots a known-good stack. A valid pointer — including one a
# successful update set to a dir under $FOULFOX_HOME/releases — is left untouched
# so updates survive reboot.
APP_CURRENT="$FOULFOX_HOME/app-current"
if [ ! -e "$APP_CURRENT" ]; then
  ln -sfn /opt/foulfox/app "$APP_CURRENT"
  echo "[foulfox-first-run] app-current -> /opt/foulfox/app (baked release 0)"
fi

# ── Interrupted-update recovery (power-loss safety) ──────────────────────────
# foulfox-patcher arms a "pending" marker before it flips app-current to a new
# release and clears it only once that release passes its health check. If the
# marker is still present now, the last update was cut short (e.g. power loss)
# before it could verify or roll back — revert to the recorded last-known-good
# app BEFORE the services start (this unit is ordered Before them), so a
# half-applied release can never boot-loop the appliance. Runs as root here, so
# the status file it writes is fixed up by the chown below. No-op when no marker.
if [ -x /usr/local/sbin/foulfox-patcher ]; then
  # boot-recover returns non-zero ONLY when a recovery marker is armed (an update
  # was cut short) AND it could not flip app-current back to the last-known-good
  # release — i.e. the still-current release is unverified/bad. Fail this oneshot:
  # foulfox-api.service and odysseus-service.service both Require= this unit, so a
  # failure here STOPS them from starting the bad release. The marker is left armed,
  # so a later boot retries recovery. (No marker / successful recovery => exit 0.)
  if ! /usr/local/sbin/foulfox-patcher boot-recover; then
    echo "[foulfox-first-run] FATAL: interrupted-update recovery could not restore the last-known-good release; refusing to start the app stack (recovery marker left armed for retry)" >&2
    exit 1
  fi
fi

# Ensure the appliance user (and the kvm group, for /dev/kvm) own runtime state —
# but DO NOT descend into the updater dirs created above: those stay root-owned so
# foulfox cannot tamper with verified releases, the staging bundle, or the
# boot-recovery marker. -prune skips both the dirs and everything under them, and
# chown -h never follows app-current (or any symlink) to the baked app it targets.
if id foulfox >/dev/null 2>&1; then
  find "$FOULFOX_HOME" \
    \( -path "$FOULFOX_HOME/releases" -o -path "$FOULFOX_HOME/venvs" \
       -o -path "$FOULFOX_HOME/update-staging" -o -path "$FOULFOX_HOME/updates" \) -prune \
    -o -print0 2>/dev/null \
    | xargs -0r chown -h foulfox:foulfox 2>/dev/null || true
  usermod -aG kvm foulfox 2>/dev/null || true
fi

# ── Persistence sanity check (non-destructive) ───────────────────────────────
# The live image boots with 'persistence persistence-label=foulfox-persist'. If
# no partition with that label exists (a plain dd/Etcher flash has none), ALL
# writes — the multi-GB Windows ISO and the 64G guest disk — land in a RAM
# overlay: they are LOST on reboot and can exhaust memory mid-install. We never
# repartition the user's stick automatically; warn loudly in the service log and
# drop a note the shell surfaces, so the user can add the partition deliberately.
if ! blkid -L foulfox-persist >/dev/null 2>&1; then
  echo "[foulfox-first-run] WARNING: no 'foulfox-persist' partition — running on a RAM overlay." >&2
  echo "[foulfox-first-run] WARNING: downloads and the Windows guest will be LOST on reboot and may exhaust memory." >&2
  echo "[foulfox-first-run] WARNING: add an ext4 partition labelled 'foulfox-persist' to the USB stick (see docs/first-boot.md)." >&2
  cat > "$FOULFOX_HOME/logs/PERSISTENCE-WARNING.txt" <<'WARN'
No 'foulfox-persist' partition was found, so FoulFox OS is running entirely in RAM.
Anything you download or install (including the Windows VM) will be ERASED on reboot,
and large downloads may run the machine out of memory. To make storage persistent,
add a second partition labelled exactly 'foulfox-persist' (ext4, containing a
'persistence.conf' of "/ union") to the USB stick. See docs/first-boot.md.
WARN
  chown foulfox:foulfox "$FOULFOX_HOME/logs/PERSISTENCE-WARNING.txt" 2>/dev/null || true
fi

# ── Locate a Windows ISO ─────────────────────────────────────────────────────
# Prefer the frontload staging dir, then any mounted removable media.
find_windows_iso() {
  local hit
  hit="$(find "$STAGING/isos" -maxdepth 1 -iname '*.iso' 2>/dev/null | sort | head -n1)"
  if [ -n "$hit" ]; then echo "$hit"; return 0; fi
  local base
  for base in /media /run/media /mnt; do
    [ -d "$base" ] || continue
    hit="$(find "$base" -maxdepth 4 \( -iname 'win*.iso' -o -iname '*windows*.iso' \) 2>/dev/null | sort | head -n1)"
    if [ -n "$hit" ]; then echo "$hit"; return 0; fi
  done
  return 0
}

# ── Locate the virtio-win driver ISO ─────────────────────────────────────────
find_virtio_iso() {
  find "$STAGING/drivers" "$STAGING/isos" -maxdepth 1 -iname 'virtio-win*.iso' 2>/dev/null | sort | head -n1
}

WIN_ISO="$(find_windows_iso)"
VIRTIO_ISO="$(find_virtio_iso)"

# Best-effort download of virtio-win when absent and a network is available.
# Post-boot internet quiet period: NO internet activity for the first
# NET_QUIET seconds after power-on (WiFi is often still settling on real
# hardware, and boot-time probes turn into slow timeouts). During the window
# the download is DEFERRED to a detached background job instead of skipped,
# so the drivers still arrive a few minutes later without blocking the boot
# chain (foulfox-api Requires this unit to finish).
NET_QUIET="${FOULFOX_NET_QUIET_SECONDS:-180}"
UPTIME_S="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999999)"
if [ -z "$VIRTIO_ISO" ]; then
  VIRTIO_URL="https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso"
  if [ "$UPTIME_S" -lt "$NET_QUIET" ] 2>/dev/null; then
    WAIT=$((NET_QUIET - UPTIME_S))
    echo "[foulfox-first-run] Internet quiet period: deferring virtio-win download by ${WAIT}s."
    # Detached: survives this oneshot exiting; same .part-then-rename safety as
    # the inline path, so a partial file is never picked up on a later boot.
    setsid bash -c "
      sleep $WAIT
      curl -sfI --connect-timeout 5 --max-time 10 https://fedorapeople.org >/dev/null 2>&1 || exit 0
      if curl -fL --retry 2 --connect-timeout 10 --max-time 300 -o '$STAGING/drivers/virtio-win.iso.part' '$VIRTIO_URL'; then
        mv '$STAGING/drivers/virtio-win.iso.part' '$STAGING/drivers/virtio-win.iso'
        chown foulfox:foulfox '$STAGING/drivers/virtio-win.iso' 2>/dev/null || true
      else
        rm -f '$STAGING/drivers/virtio-win.iso.part'
      fi
    " >>"$FOULFOX_HOME/logs/virtio-download.log" 2>&1 < /dev/null &
  else
    # Hard timeouts: without them a half-up network (DNS blackhole, captive
    # portal) can hang this probe for minutes and stall the whole boot chain.
    if curl -sfI --connect-timeout 5 --max-time 10 https://fedorapeople.org >/dev/null 2>&1; then
      # Download to a .part name and rename only on success: a timed-out partial
      # file must never be picked up by find_virtio_iso on the next boot.
      if curl -fL --retry 2 --connect-timeout 10 --max-time 300 -o "$STAGING/drivers/virtio-win.iso.part" "$VIRTIO_URL"; then
        mv "$STAGING/drivers/virtio-win.iso.part" "$STAGING/drivers/virtio-win.iso"
        VIRTIO_ISO="$STAGING/drivers/virtio-win.iso"
      else
        rm -f "$STAGING/drivers/virtio-win.iso.part"
      fi
    fi
  fi
fi

# ── Hardware-adaptive VM sizing ──────────────────────────────────────────────
# When a sizing dimension is left as "auto" (the default in foulfox.env), size it
# to the detected hardware with the SAME planner the api-server/setup wizard use,
# so a small machine stays conservative and a capable one stretches its legs. A
# concrete value pinned in foulfox.env always wins. Sizing only runs on a FRESH
# guest (before the disk exists); an existing disk keeps its current size. The
# planner is best-effort — if node or the bundled CLI is unavailable we fall back
# to safe static defaults, so first boot can never be blocked by sizing.
PLAN_CLI="$APP_CURRENT/artifacts/api-server/dist/storage-plan.mjs"
if [ ! -f "$DISK" ] && { [ "$DISK_SIZE" = "auto" ] || [ "$RAM_GB" = "auto" ] || [ "$CPU_CORES" = "auto" ]; }; then
  PLAN_OUT=""
  if command -v node >/dev/null 2>&1 && [ -f "$PLAN_CLI" ]; then
    # ODYSSEUS_DATA_DIR makes the planner measure the persistent partition (where
    # the guest disk lives), matching the api-server's disk guardrail.
    PLAN_ENV=(ODYSSEUS_DATA_DIR="$FOULFOX_HOME")
    [ -n "${FOULFOX_DISK_RESERVE_GB:-}" ] && PLAN_ENV+=(FOULFOX_DISK_RESERVE_GB="$FOULFOX_DISK_RESERVE_GB")
    PLAN_OUT="$(env "${PLAN_ENV[@]}" node "$PLAN_CLI" 2>/dev/null || true)"
  fi
  if [ -n "$PLAN_OUT" ]; then
    # Only eval our own well-formed KEY=value lines (defense in depth).
    eval "$(printf '%s\n' "$PLAN_OUT" | grep -E '^FOULFOX_PLAN_(DISK_GB|RAM_GB|CPU_CORES|TIER|DISK_KNOWN)=[A-Za-z0-9]+$' || true)"
  fi
  [ "$DISK_SIZE" = "auto" ] && DISK_SIZE="${FOULFOX_PLAN_DISK_GB:-64}G"
  [ "$RAM_GB" = "auto" ] && RAM_GB="${FOULFOX_PLAN_RAM_GB:-8}"
  [ "$CPU_CORES" = "auto" ] && CPU_CORES="${FOULFOX_PLAN_CPU_CORES:-4}"
  echo "[foulfox-first-run] Adaptive VM sizing: disk=$DISK_SIZE ram=${RAM_GB}G cpu=$CPU_CORES tier=${FOULFOX_PLAN_TIER:-unknown}"
fi
# Final guard: never let an unresolved "auto" reach qemu-img / the VM config
# (e.g. an existing disk skipped the block above, or the CLI failed).
[ "$DISK_SIZE" = "auto" ] && DISK_SIZE="64G"
[ "$RAM_GB" = "auto" ] && RAM_GB="8"
[ "$CPU_CORES" = "auto" ] && CPU_CORES="4"

# ── Create the guest disk only when there's something to install or run ──────
# Create it the first time a Windows ISO appears (the user is ready to install),
# and keep using it once it exists (so an installed guest still boots after the
# ISO is removed). Until then leave diskPath null so foulfox-vm-autostart
# correctly no-ops instead of booting a blank disk.
DISK_FIELD="null"
if [ -f "$DISK" ] || [ -n "$WIN_ISO" ]; then
  if [ ! -f "$DISK" ]; then
    qemu-img create -f qcow2 "$DISK" "$DISK_SIZE"
  fi
  DISK_FIELD="\"$DISK\""
fi

# ── Write the VM config the api-server reads ─────────────────────────────────
json_or_null() { if [ -n "${1:-}" ]; then printf '"%s"' "$1"; else printf 'null'; fi; }

cat > "$CONFIG" <<JSON
{
  "isoPath": $(json_or_null "$WIN_ISO"),
  "diskPath": $DISK_FIELD,
  "virtioIsoPath": $(json_or_null "$VIRTIO_ISO"),
  "ramGb": $RAM_GB,
  "cpuCores": $CPU_CORES,
  "displayMode": "$DISPLAY_MODE",
  "spicePort": $SPICE_PORT,
  "connectionMode": "ssh"
}
JSON
chown foulfox:foulfox "$CONFIG" 2>/dev/null || true

echo "[foulfox-first-run] Windows ISO: ${WIN_ISO:-<none — frontload one via the File Explorer>}"
echo "[foulfox-first-run] virtio ISO:  ${VIRTIO_ISO:-<none — Windows can still install, drivers optional>}"
echo "[foulfox-first-run] Guest disk:  $DISK ($DISK_SIZE)"
