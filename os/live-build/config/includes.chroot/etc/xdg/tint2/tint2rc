# FoulFox OS taskbar (tint2).
# System-wide default: the foulfox user has no ~/.config/tint2/tint2rc, so
# tint2 falls back to this XDG config. Bottom panel with one button per open
# window + a clock. The panel reserves its strip of screen (strut), so
# maximized windows — including the FoulFox shell — never cover it.

# ── Backgrounds ───────────────────────────────────────────────────────────────
# Background 1: panel
rounded = 0
border_width = 0
background_color = #16181d 100
border_color = #16181d 100

# Background 2: task button (normal)
rounded = 6
border_width = 1
background_color = #262a33 100
border_color = #3a4050 100

# Background 3: task button (active window)
rounded = 6
border_width = 1
background_color = #3d4456 100
border_color = #ff8800 100

# ── Panel ─────────────────────────────────────────────────────────────────────
panel_items = TC
panel_position = bottom center horizontal
panel_size = 100% 44
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_layer = top
panel_monitor = primary
strut_policy = follow_size
wm_menu = 1
panel_window_name = tint2
panel_dock = 0
autohide = 0

# ── Taskbar ───────────────────────────────────────────────────────────────────
taskbar_mode = single_desktop
taskbar_padding = 0 0 6
taskbar_background_id = 0
taskbar_name = 0

task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 240 36
task_padding = 8 4 6
task_font = sans 11
task_font_color = #d8dbe2 100
task_active_font_color = #ffffff 100
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_font_color = #9aa0ad 100
task_tooltip = 1

# Left-click a button: bring the window to the front (or minimize it if it is
# already in front). Middle-click: close the window.
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none

# ── Clock ─────────────────────────────────────────────────────────────────────
time1_format = %H:%M
time1_font = sans Bold 12
time2_format = %a %d %b
time2_font = sans 9
clock_font_color = #d8dbe2 100
clock_padding = 10 0
clock_background_id = 0
