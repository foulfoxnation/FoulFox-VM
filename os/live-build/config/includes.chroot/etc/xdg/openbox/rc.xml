<?xml version="1.0" encoding="UTF-8"?>
<!-- FoulFox OS system-wide Openbox config for the kiosk session.
     Purpose: window switching between the kiosk / browsers / VM viewer, plus
     keyboard shortcuts to open a general-purpose browser over the kiosk:
       Super+F -> Firefox      Super+C -> Chromium      Alt-Tab -> switch
     Kept minimal but complete; the foulfox user has no per-user override, so
     Openbox falls back to this XDG default. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <!-- Bigger titlebar text -> Openbox scales the titlebar and its
         minimize/maximize/close buttons with the font. The default was tiny
         and near-unclickable on the appliance's 1080p+ screen. -->
    <font place="ActiveWindow"><name>sans</name><size>13</size><weight>Bold</weight></font>
    <font place="InactiveWindow"><name>sans</name><size>13</size><weight>Normal</weight></font>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
  </desktops>
  <keyboard>
    <!-- Window switching — Alt+Tab / Alt+Shift+Tab (Windows-standard). -->
    <keybind key="A-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Close the focused window — Alt+F4 (Windows-standard). -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>

    <!-- Maximize / restore — Super+Up / Super+Down (Windows-standard). -->
    <keybind key="W-Up">
      <action name="Maximize"/>
    </keybind>
    <keybind key="W-Down">
      <action name="Unmaximize"/>
    </keybind>

    <!-- Snap window left / right — Super+Left / Super+Right. -->
    <keybind key="W-Left">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x><y>0</y><width>50%</width><height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Right">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>50%</x><y>0</y><width>50%</width><height>100%</height>
      </action>
    </keybind>

    <!-- Show desktop — Super+D (Windows-standard). -->
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>

    <!-- Screenshots — PrintScreen = full screen, Alt+PrintScreen = active window.
         Saved to ~/Documents/Screenshots/ with Windows-style filenames. -->
    <keybind key="Print">
      <action name="Execute">
        <command>/usr/local/bin/foulfox-screenshot full</command>
      </action>
    </keybind>
    <keybind key="A-Print">
      <action name="Execute">
        <command>/usr/local/bin/foulfox-screenshot window</command>
      </action>
    </keybind>

    <!-- Open a browser over the kiosk. -->
    <keybind key="W-f">
      <action name="Execute">
        <command>/usr/local/bin/foulfox-open-browser firefox</command>
      </action>
    </keybind>
    <keybind key="W-c">
      <action name="Execute">
        <command>/usr/local/bin/foulfox-open-browser chromium</command>
      </action>
    </keybind>
  </keyboard>
  <mouse>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
  </mouse>
  <applications>
    <!-- Browsers open as normal decorated windows, maximized for usability;
         still movable/closable. The kiosk Chromium (fullscreen kiosk mode) is
         unaffected: fullscreen windows ignore decoration/maximize hints. -->
    <!-- <fullscreen>no</fullscreen>: Firefox must never map fullscreen over
         the kiosk (no titlebar = no way out for a non-technical user). -->
    <application class="firefox-esr" type="normal">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
    </application>
    <application class="Firefox-esr" type="normal">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
    </application>
    <!-- Discord (Electron, class "discord") — normal decorated window. -->
    <application class="discord" type="normal">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
    </application>
    <application class="Discord" type="normal">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
    </application>
    <!-- The user-facing Chromium window (separate profile launched by
         foulfox-open-browser). Decorated + maximized + focused so new windows
         (e.g. OAuth sign-in popups) always come to the front instead of
         opening behind the fullscreen kiosk. -->
    <!-- <fullscreen>no</fullscreen>: the kiosk instance now runs with its own
         WM class (FoulFoxKiosk, set in foulfox-kiosk), so any window that maps
         with the plain Chromium class is a user-facing browser window and must
         never start fullscreen/undecorated (there would be no way out). Users
         can still toggle fullscreen later (F11 / video fullscreen). -->
    <application class="Chromium" type="normal">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
    </application>
    <application class="chromium" type="normal">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
    </application>
    <!-- Chromium dialogs/popups (OAuth windows are type "dialog" sometimes) -->
    <application class="Chromium" type="dialog">
      <decor>yes</decor>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
