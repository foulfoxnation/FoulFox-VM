## FoulFox power management — allow the api-server (running as foulfox) to
## trigger shutdown, reboot, and suspend via systemctl without a password.
## Both plain and `-i` (ignore logind inhibitors) forms are whitelisted: block
## inhibitors from NetworkManager/session daemons otherwise make the plain
## command refuse and the appliance can never power off from the shell UI.
foulfox ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot, /usr/bin/systemctl suspend, /usr/bin/systemctl -i poweroff, /usr/bin/systemctl -i reboot, /usr/bin/systemctl -i suspend
