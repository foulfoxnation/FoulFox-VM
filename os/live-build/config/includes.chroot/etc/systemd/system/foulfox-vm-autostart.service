[Unit]
Description=FoulFox Windows VM autostart (no-op until a guest is configured)
After=foulfox-api.service
Requires=foulfox-api.service

[Service]
# simple (not oneshot): first-boot provisioning may download the Windows ISO
# from Microsoft (multi-GB). The boot must never wait on that — the kiosk and
# shell come up immediately while this runs in the background.
Type=simple
EnvironmentFile=/etc/foulfox/foulfox.env
ExecStart=/usr/local/bin/foulfox-vm-autostart

[Install]
WantedBy=multi-user.target
