[Unit]
Description=Odysseus AI agent (FastAPI, loopback :7000)
# Do NOT wait on network-online.target: Odysseus is a local agent; waiting
# ~90-120s for a network that may never come (no WiFi configured) delays
# startup and makes the shell show "FoulFox OS Offline" until it times out.
After=foulfox-prepare.service
Requires=foulfox-prepare.service

[Service]
Type=simple
User=foulfox
Group=foulfox
EnvironmentFile=/etc/foulfox/foulfox.env
# PORT: foulfox.env sets PORT=8080 for the api-server, and systemd's
# EnvironmentFile ALWAYS overrides Environment= lines (regardless of order in
# this file) — so an Environment=PORT=7000 override here can never win, and
# Odysseus would bind 8080, collide with the api-server, and crash-loop.
# The port is therefore selected inside start.sh, which prefers foulfox.env's
# ODYSSEUS_PORT=7000 over PORT. Do not add Environment=PORT here.
# Run from the active app release (a symlink the patcher flips for live updates);
# defaults to the baked /opt/foulfox/app. See foulfox-first-run + foulfox-patcher.
WorkingDirectory=/var/lib/foulfox/app-current/artifacts/odysseus-service
ExecStart=/usr/bin/env bash /var/lib/foulfox/app-current/artifacts/odysseus-service/start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
