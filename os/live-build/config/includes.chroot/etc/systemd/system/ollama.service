[Unit]
Description=Ollama local LLM server (FoulFox local AI, loopback :11434)
# Deferred start: the baked ~5 GB model is seeded by foulfox-seed-ollama.service
# AFTER the user-facing stack (shell + Odysseus) is up, so ollama starts once the
# model store is ready instead of blocking the boot chain. Requires= keeps the
# same fail-closed boot invariant as the other FoulFox services.
After=foulfox-prepare.service foulfox-seed-ollama.service
Wants=foulfox-seed-ollama.service
Requires=foulfox-prepare.service
# Local server: never wait on network-online.target (offline boot is the norm).

[Service]
Type=simple
User=foulfox
Group=foulfox
EnvironmentFile=/etc/foulfox/foulfox.env
Environment=HOME=/var/lib/foulfox
# Bind loopback only; models live on the persistent partition (seeded from the
# read-only baked copy by foulfox-first-run so `ollama pull` of new models works).
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/foulfox/ollama/models
# Keep the model warm between requests; single-user appliance.
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=OLLAMA_NUM_PARALLEL=1
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
