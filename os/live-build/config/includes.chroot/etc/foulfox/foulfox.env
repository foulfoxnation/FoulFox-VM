# FoulFox OS runtime environment.
# Sourced by the systemd services, the first-run provisioner, and the kiosk.
# These are appliance defaults; foulfox-first-run composes the VM config the
# api-server reads (/var/lib/foulfox/.odysseus-vm-config.json) from them.

HOME=/var/lib/foulfox
NODE_ENV=production

# Shared persistent data root (on the foulfox-persist overlay). Both the
# api-server (VM registry/config) and the Odysseus FastAPI agent honor
# ODYSSEUS_DATA_DIR, so pinning it keeps ALL mutable state in one place under
# the persistence partition instead of the read-only app dir.
ODYSSEUS_DATA_DIR=/var/lib/foulfox

# Paths below resolve through /var/lib/foulfox/app-current — a symlink to the
# active app release that foulfox-patcher flips for live updates (defaults to the
# baked /opt/foulfox/app). Keeps the shell + Odysseus dirs swappable in lockstep.

# ── api-server (Express): serves the built shell + /api + Odysseus proxy ─────
PORT=8080
HOST=127.0.0.1
SERVE_SHELL_STATIC=1
SHELL_STATIC_DIR=/var/lib/foulfox/app-current/artifacts/odysseus-shell/dist/public

# ── Local AI (Ollama, baked into the image) ──────────────────────────────────
# The ISO ships Ollama + this model so a fresh machine has working local AI
# with no internet. ollama.service serves it on loopback :11434; Odysseus
# auto-registers the endpoint and assigns it to all 3 agent roles at startup
# (only when no model is configured yet — never overrides a user's choice).
# Keep the model name in sync with hooks/normal/0040-foulfox-ollama.hook.chroot.
FOULFOX_LOCAL_OLLAMA=1
FOULFOX_LOCAL_MODEL=llama3.1:8b-instruct-q4_K_M

# ── Ollama memory & performance tuning ───────────────────────────────────────
# These apply on ALL machines. Hardware-specific GPU config (OLLAMA_NUM_GPU,
# OLLAMA_NUM_THREADS) is written by foulfox-first-run into /etc/foulfox/ollama-hw.env
# and loaded by ollama.service as an optional EnvironmentFile.
#
# CONTEXT_LENGTH: 2048 tokens uses ~400 MB less RAM/VRAM than the 4096 default
# on the 8B model. Raise to 4096 in the shell if you need longer conversations.
OLLAMA_CONTEXT_LENGTH=2048
# Flash attention: fuses the attention computation — reduces peak memory by
# ~20% and speeds up inference; safe on all CUDA/CPU hardware.
OLLAMA_FLASH_ATTENTION=1
# KV cache in 8-bit (q8_0): halves the memory the key-value cache occupies
# vs default fp16. Negligible quality loss on 4-bit quantized models.
OLLAMA_KV_CACHE_TYPE=q8_0
# Single-user appliance: keep exactly one model loaded. Unloading between
# requests wastes time; two models loaded at once wastes RAM.
OLLAMA_MAX_LOADED_MODELS=1
# Keep the model hot for 60 minutes of idle (instead of default 5 min) so a
# brief pause mid-conversation doesn't trigger a slow reload.
OLLAMA_KEEP_ALIVE=60m

# ── Odysseus FastAPI agent (loopback; proxied by api-server) ─────────────────
ODYSSEUS_PORT=7000
ODYSSEUS_DIR=/var/lib/foulfox/app-current/artifacts/odysseus-service

# ── Live app updates (foulfox-patcher) ──────────────────────────────────────
# The patcher pulls a checksummed app bundle from a rolling GitHub release and
# swaps it in atomically with a health-checked, automatic rollback — no reflash.
# It reuses FOULFOX_GITHUB_REPO (the same var /api/os/release-info uses for the
# ISO link): set it to "owner/repo" of the repo whose Actions publish the bundle.
# To host the bundle elsewhere, point FOULFOX_APP_MANIFEST_URL at the manifest.
FOULFOX_GITHUB_REPO=foulfoxnation/FoulFox-VM
# FOULFOX_APP_MANIFEST_URL=
# Fallback update source: the published FoulFox site mirrors the manifest AND
# the bundle (api-server routes/updates.ts), so a device that can't reach
# GitHub (rate limit, DNS) still updates. Tried only when GitHub fails.
FOULFOX_UPDATE_MIRROR=https://odysseus-vm.replit.app/api/updates/foulfox-app-latest.json
FOULFOX_APP_RELEASES_KEEP=2

# ── Post-boot internet quiet period ──────────────────────────────────────────
# For this many seconds after power-on, ALL outbound internet activity is held
# back (GitHub release/update probes, ISO build triggers, update applies, the
# virtio driver download). Local AI + the agent are unaffected — this only
# stops boot-time internet chatter while WiFi is still settling. 0 disables.
FOULFOX_NET_QUIET_SECONDS=180

# ── File explorer / USB frontload staging (drivers, isos, files) ─────────────
FRONTLOAD_STAGING_DIR=/var/lib/foulfox/frontload

# ── Windows guest display: a fullscreen SPICE viewer attaches on boot ────────
VM_DISPLAY_MODE=spice
VM_SPICE_PORT=5930

# ── Windows guest sizing (used by foulfox-first-run when writing VM config) ──
# "auto" = let foulfox-first-run size the guest to the detected hardware
# (conservative on a small machine, larger on a capable one) using the same
# planner the setup wizard shows. Pin a concrete value to override: a qcow2 size
# string for the disk (e.g. VM_DISK_SIZE=128G) and integers for RAM/CPU. Sizing
# is computed once, before the guest disk is created; an existing disk is left
# as-is. FOULFOX_DISK_RESERVE_GB (default 30) is held back for FoulFox OS + apps.
VM_RAM_GB=auto
VM_CPU_CORES=auto
VM_DISK_SIZE=auto
# FOULFOX_DISK_RESERVE_GB=30
