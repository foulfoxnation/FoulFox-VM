#!/bin/sh
# Chroot hook: create the appliance user, enable the FoulFox services, and wire
# up graphical autologin into the kiosk session. Runs at image-build time.
set -e

# ── Appliance user (runs the services + the kiosk X session) ─────────────────
if ! id foulfox >/dev/null 2>&1; then
  adduser --disabled-password --gecos "FoulFox" \
    --home /var/lib/foulfox --shell /bin/bash foulfox
fi
# Group memberships: KVM (/dev/kvm), USB hotplug/passthrough, networking, X
# video, and Bluetooth (the `bluetooth` group exists only once bluez is
# installed — the getent guard skips it harmlessly if it is absent).
for grp in kvm plugdev netdev video bluetooth systemd-journal adm; do
  getent group "$grp" >/dev/null 2>&1 && adduser foulfox "$grp" || true
done
# LightDM autologin in Debian requires membership in the "autologin" group.
groupadd -f autologin
adduser foulfox autologin || true

# ── Enable the FoulFox services ──────────────────────────────────────────────
systemctl enable foulfox-prepare.service
systemctl enable odysseus-service.service
systemctl enable foulfox-api.service
systemctl enable foulfox-vm-autostart.service
systemctl enable ollama.service
systemctl enable foulfox-seed-ollama.service
# GPU driver fallback: if the baked NVIDIA module can't load on this machine,
# explicitly load nouveau so the kiosk NEVER boots to a black screen.
chmod 0755 /usr/local/sbin/foulfox-gpu-fallback
systemctl enable foulfox-gpu-fallback.service
# Automatic app updates: periodic check + apply via foulfox-patcher.
chmod 0755 /usr/local/sbin/foulfox-update-autocheck
systemctl enable foulfox-update-check.timer
# First-boot hardware benchmark ("vibe check") — one-time, results feed the
# Diagnostics tab via /api/system/benchmark.
chmod 0755 /usr/local/bin/foulfox-benchmark
systemctl enable foulfox-benchmark.service

# ── Enable plug-and-play hardware daemons ────────────────────────────────────
# NetworkManager (wired auto-DHCP + wifi management) and BlueZ (Bluetooth). The
# packages usually enable these via systemd presets, but enable explicitly so a
# preset change can never leave the appliance with no networking/Bluetooth.
systemctl enable NetworkManager.service
systemctl enable bluetooth.service

# ── DNS: systemd-resolved ─────────────────────────────────────────────────────
# Enable the stub resolver so DNS works immediately on first boot. NM detects
# resolved and writes nameserver 127.0.0.53 (the stub) into its internal config
# rather than /etc/resolv.conf, preventing boot-time races.
# The canonical symlink makes every process that reads /etc/resolv.conf use the
# stub resolver (with DNSSEC + caching) instead of a plain forwarding file.
if systemctl enable systemd-resolved 2>/dev/null; then
  ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf || true
fi

# ── Graphical autologin straight into the kiosk session ──────────────────────
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-foulfox-autologin.conf <<EOF
[Seat:*]
autologin-user=foulfox
autologin-user-timeout=0
user-session=foulfox-kiosk
greeter-session=lightdm-gtk-greeter
EOF

mkdir -p /usr/share/xsessions
cat > /usr/share/xsessions/foulfox-kiosk.desktop <<EOF
[Desktop Entry]
Name=FoulFox Kiosk
Comment=FoulFox VM kiosk session
Exec=/usr/local/bin/foulfox-kiosk
Type=Application
EOF

# Boot to the graphical target.
systemctl set-default graphical.target

# ── Pre-seeded WiFi (NetworkManager keyfiles) ─────────────────────────────────
# NetworkManager REFUSES to load a system-connection keyfile unless it is owned
# by root and mode 0600 (it contains the wifi PSK). Enforce that here so the
# baked network profile actually autoconnects on first boot.
if [ -d /etc/NetworkManager/system-connections ]; then
  chown root:root /etc/NetworkManager/system-connections/*.nmconnection 2>/dev/null || true
  chmod 0600 /etc/NetworkManager/system-connections/*.nmconnection 2>/dev/null || true
fi

# ── Permissions ──────────────────────────────────────────────────────────────
chmod +x /usr/local/bin/foulfox-first-run \
         /usr/local/bin/foulfox-seed-ollama \
         /usr/local/bin/foulfox-kiosk \
         /usr/local/bin/foulfox-open-vm-viewer \
         /usr/local/bin/foulfox-open-browser \
         /usr/local/bin/foulfox-vm-autostart
