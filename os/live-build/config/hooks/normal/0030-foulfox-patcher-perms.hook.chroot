#!/bin/sh
# Lock down the live updater + its sudoers drop-in. Git can record the +x bit but
# not the 0440 mode sudo demands for files in /etc/sudoers.d, so set it here and
# validate the drop-in so a typo can never lock sudo out at boot.
set -e

chmod 0755 /usr/local/sbin/foulfox-patcher

if [ -f /etc/sudoers.d/foulfox-patcher ]; then
  chown root:root /etc/sudoers.d/foulfox-patcher
  chmod 0440 /etc/sudoers.d/foulfox-patcher
  visudo -cf /etc/sudoers.d/foulfox-patcher
fi

# Same treatment for the storage-setup helper (auto-partition the persistence
# disk) and its sudoers drop-in.
chmod 0755 /usr/local/sbin/foulfox-storage-setup

if [ -f /etc/sudoers.d/foulfox-storage-setup ]; then
  chown root:root /etc/sudoers.d/foulfox-storage-setup
  chmod 0440 /etc/sudoers.d/foulfox-storage-setup
  visudo -cf /etc/sudoers.d/foulfox-storage-setup
fi

# Same treatment for the disk-install helper (install live OS to internal disk)
# and its sudoers drop-in. Runs as root so it can partition, format, rsync,
# and grub-install the target drive.
chmod 0755 /usr/local/sbin/foulfox-install-to-disk

if [ -f /etc/sudoers.d/foulfox-install-to-disk ]; then
  chown root:root /etc/sudoers.d/foulfox-install-to-disk
  chmod 0440 /etc/sudoers.d/foulfox-install-to-disk
  visudo -cf /etc/sudoers.d/foulfox-install-to-disk
fi

# Power management sudoers drop-in (shutdown / reboot / suspend via systemctl).
if [ -f /etc/sudoers.d/foulfox-power ]; then
  chown root:root /etc/sudoers.d/foulfox-power
  chmod 0440 /etc/sudoers.d/foulfox-power
  visudo -cf /etc/sudoers.d/foulfox-power
fi
