#!/bin/bash
# Install Node.js 20 from NodeSource, replacing Debian's Node 18.
# Debian bookworm's 'nodejs' package = v18.x. FoulFox apps require >=20.
set -e

echo "[foulfox] Installing Node.js 20 from NodeSource…"

# Remove the Debian-provided nodejs/npm if present (from the package list
# or pulled in as a dependency). NodeSource will install its own binaries.
apt-get remove -y --purge nodejs npm 2>/dev/null || true
apt-get autoremove -y 2>/dev/null || true

# Bootstrap NodeSource apt repo for Node 20.
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -

apt-get install -y nodejs

echo "[foulfox] Node.js $(node --version) / npm $(npm --version) installed."
